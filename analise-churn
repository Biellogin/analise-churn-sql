-- 2. ANÁLISE DE CHURN COM CTE E CASE WHEN
WITH CalculoInatividade AS (
    SELECT 
        cliente_id,
        nome,
        valor_mensal,
        ultima_atividade,
        ('2026-07-28'::DATE - ultima_atividade) AS dias_sem_acesso
    FROM assinaturas
)
SELECT 
    cliente_id,
    nome,
    valor_mensal,
    dias_sem_acesso,
    CASE 
        WHEN dias_sem_acesso <= 30 THEN '1. Ativo'
        WHEN dias_sem_acesso BETWEEN 31 AND 60 THEN '2. Risco Moderado'
        ELSE '3. Alto Risco / Churn'
    END AS status_churn
FROM CalculoInatividade
ORDER BY dias_sem_acesso DESC;
